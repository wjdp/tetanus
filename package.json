{
  "name": "tetanus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "biome check --write",
    "lint:ci": "biome ci",
    "typecheck": "nuxt typecheck",
    "test": "vitest",
    "test:host": "bash host/test/run.sh",
    "db:migrate": "tsx server/database/migrate-cli.ts",
    "db:check": "drizzle-kit check && drizzle-kit generate --name schema_drift && git diff --quiet HEAD -- server/database/migrations && test -z \"$(git ls-files --others --exclude-standard server/database/migrations)\" || { echo \"Migrations are out of step with schema.ts; run drizzle-kit generate\" >&2; exit 1; }",
    "db:studio": "drizzle-kit studio",
    "demo:seed": "tsx --tsconfig .nuxt/tsconfig.server.json server/demo/cli.ts seed",
    "demo:tick": "tsx --tsconfig .nuxt/tsconfig.server.json server/demo/cli.ts tick",
    "build:demo": "pnpm demo:schema && TETANUS_TARGET=cloudflare nuxt build",
    "demo:schema": "tsx deploy/cloudflare/bundleSchema.ts",
    "demo:check-schema": "pnpm demo:schema && tsx deploy/cloudflare/checkSchema.ts",
    "demo:typecheck": "pnpm demo:schema && tsc -p deploy/cloudflare",
    "demo:dev": "wrangler dev -c deploy/cloudflare/wrangler.jsonc",
    "demo:deploy": "wrangler deploy -c deploy/cloudflare/wrangler.jsonc"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.154",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "better-sqlite3": "^13.1.1",
    "d3-hierarchy": "^3.1.3",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "h3": "^1.15.11",
    "markdown-it": "^15.0.3",
    "uplot": "^1.6.32"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "pnpm": ">=12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@cloudflare/workers-types": "^5.20261113.1",
    "@nuxt/test-utils": "4.4.0",
    "@nuxt/ui": "^4.12.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/markdown-it": "^14.2.0",
    "@types/sortablejs": "^1.15.9",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/integrations": "^15.0.0",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^21.0.4",
    "hookable": "^5.5.3",
    "lefthook": "2.2.1",
    "nuxt": "^4.6.4",
    "only-allow": "^1.2.2",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "vue": "latest",
    "vue-router": "latest",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.161.0",
    "zod": "^4.6.7"
  }
}
