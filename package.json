{
  "name": "tetanus",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "biome check --write",
    "lint:ci": "biome ci",
    "typecheck": "nuxt typecheck",
    "test": "vitest",
    "test:host": "bash host/test/run.sh",
    "db:migrate": "tsx server/database/migrate-cli.ts",
    "db:studio": "drizzle-kit studio",
    "demo:seed": "tsx --tsconfig .nuxt/tsconfig.server.json server/demo/cli.ts seed",
    "demo:tick": "tsx --tsconfig .nuxt/tsconfig.server.json server/demo/cli.ts tick",
    "build:demo": "pnpm demo:migrations && TETANUS_TARGET=cloudflare nuxt build",
    "demo:migrations": "tsx deploy/cloudflare/bundleMigrations.ts",
    "demo:check-migrations": "pnpm demo:migrations && tsx deploy/cloudflare/checkMigrations.ts",
    "demo:typecheck": "pnpm demo:migrations && tsc -p deploy/cloudflare",
    "demo:dev": "wrangler dev -c deploy/cloudflare/wrangler.jsonc",
    "demo:deploy": "wrangler deploy -c deploy/cloudflare/wrangler.jsonc"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.137",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.3",
    "h3": "^1.15.11",
    "markdown-it": "^15.0.2",
    "uplot": "^1.6.32"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "pnpm": ">=12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@cloudflare/workers-types": "^5.20260926.1",
    "@nuxt/test-utils": "4.2.0",
    "@nuxt/ui": "^4.11.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/markdown-it": "^14.2.0",
    "@types/sortablejs": "^1.15.9",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/integrations": "^14.4.0",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^20.14.5",
    "hookable": "^5.5.3",
    "lefthook": "^2.1.14",
    "nuxt": "^4.5.2",
    "only-allow": "^1.2.2",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vue": "latest",
    "vue-router": "latest",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.141.0",
    "zod": "^4.6.5"
  }
}
