{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2024"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "paths": { "#shared/*": ["../../shared/*"] }
  },
  "include": ["*.ts", "*.d.ts", "migrationCheck/*.ts"],
  "exclude": ["nuxt.config.ts", "bundleMigrations.ts", "checkMigrations.ts"]
}
