{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "tetanus-schema-check",
  "main": "worker.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "CHECK", "class_name": "SchemaCheck" }]
