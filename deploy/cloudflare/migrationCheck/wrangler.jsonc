{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "tetanus-migration-check",
  "main": "worker.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "CHECK", "class_name": "MigrationCheck" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MigrationCheck"] }]
}
